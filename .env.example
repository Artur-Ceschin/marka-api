# Local development only.
# Deployed environments get these from sls/config/provider.yml.
NODE_ENV=dev
PORT=3333

# Auth. There is no local Cognito emulator, so `pnpm dev` talks to the real
# deployed user pool. Fill these in after the first `pnpm sls:deploy`:
#   AWS_PROFILE=marka serverless info --verbose
# Leave them blank and /health and /identify still work — only the /auth
# routes fail, with a message telling you this.
AWS_REGION=us-east-1
USER_POOL_ID=
USER_POOL_CLIENT_ID=
USERS_TABLE=
