{
  "name": "marka-api",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main/server.ts",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:bundle": "pnpm build && NODE_ENV=production node --test scripts/bundle.test.mjs",
    "sls:print": "AWS_PROFILE=marka serverless print",
    "sls:deploy": "pnpm build && AWS_PROFILE=marka serverless deploy",
    "sls:logs": "AWS_PROFILE=marka serverless logs --tail --function",
    "sls:remove": "AWS_PROFILE=marka serverless remove",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:bundle",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1129.0",
    "@aws-sdk/client-dynamodb": "^3.1129.0",
    "@aws-sdk/lib-dynamodb": "^3.1129.0",
    "@fastify/aws-lambda": "^6.4.1",
    "@fastify/multipart": "^10.1.0",
    "aws-jwt-verify": "^5.2.1",
    "fastify": "^5.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.2",
    "esbuild": "^0.25.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,mjs,js,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
